# Set to production in Coolify. Production ignores local .env files.
APP_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SECRET: configure only in the API service environment; never expose to the web.
SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder

INITIAL_ADMIN_EMAIL=initial-admin@example.com

# Optional Production & Throttling Configurations
# THROTTLE_TTL: rate limit window in milliseconds (default: 60000 = 60s)
THROTTLE_TTL=60000
# THROTTLE_LIMIT: max requests per rate limit window (default: 120)
THROTTLE_LIMIT=120
# TRUST_PROXY: set true behind the single Coolify reverse-proxy hop.
TRUST_PROXY=false

# Optional holiday provider integration.
CALENDARIFIC_API_KEY=
