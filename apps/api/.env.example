APP_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

INITIAL_ADMIN_EMAIL=admin@example.com

# Optional Production & Throttling Configurations
# THROTTLE_TTL: rate limit window in milliseconds (default: 60000 = 60s)
THROTTLE_TTL=60000
# THROTTLE_LIMIT: max requests per rate limit window (default: 120)
THROTTLE_LIMIT=120
# TRUST_PROXY: enable when behind reverse proxy (default: true in production, false otherwise)
TRUST_PROXY=false
