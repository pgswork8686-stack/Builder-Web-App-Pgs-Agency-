# Copy to deploy/vps/.env and fill privately. Never commit live secrets.
# Both domains must have DNS A/AAAA records pointing at the VPS.
WEB_DOMAIN=hub.example.com
API_DOMAIN=api.hub.example.com
ACME_EMAIL=ops@example.com

# Existing PGS Supabase backend remains the data/auth/storage provider.
# This VPS deployment does NOT migrate or erase existing data.
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-private-server-key
DATABASE_URL=postgresql://user:password@db.example.com:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@example.com
